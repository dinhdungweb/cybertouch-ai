{% doc %}
  @prompt
    Create a custom button block for a Shopify theme page that includes a built-in horizontal alignment setting (left, center, right) controllable from the Theme Editor. The button should have customizable label text, a link URL, and styling options like button color and text color. Default alignment should be center., the button need to be linked to a https address, This button should have the standard button styling, using the color scheme of the existing website pages., This button should have a cyberpunk-style neon background, with bright blue text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-button-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-custom-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    {% if block.settings.alignment == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  .ai-custom-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    min-width: {{ block.settings.min_width }}px;
    min-height: {{ block.settings.min_height }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-decoration: none;
    cursor: pointer;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 
      0 0 {{ block.settings.glow_intensity }}px {{ block.settings.glow_color }},
      inset 0 0 {{ block.settings.inner_glow }}px {{ block.settings.glow_color }};
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-custom-button-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    transition: left 0.5s ease;
  }

  .ai-custom-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.hover_background_color }};
    color: {{ block.settings.hover_text_color }};
    box-shadow: 
      0 0 {{ block.settings.hover_glow_intensity }}px {{ block.settings.glow_color }},
      inset 0 0 {{ block.settings.hover_inner_glow }}px {{ block.settings.glow_color }};
    transform: translateY(-2px);
  }

  .ai-custom-button-{{ ai_gen_id }}:hover::before {
    left: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-custom-button-{{ ai_gen_id }} {
      min-width: {{ block.settings.desktop_min_width }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-custom-button-wrapper-{{ ai_gen_id }} {
      {% if block.settings.mobile_alignment == 'left' %}
        justify-content: flex-start;
      {% elsif block.settings.mobile_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_alignment == 'right' %}
        justify-content: flex-end;
      {% endif %}
    }

    .ai-custom-button-{{ ai_gen_id }} {
      {% if block.settings.mobile_full_width %}
        width: 100%;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-custom-button-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-button-wrapper-{{ ai_gen_id }}">
    <a href="{{ block.settings.button_link }}" class="ai-custom-button-{{ ai_gen_id }}">
      {{ block.settings.button_label }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Cyberpunk button",
  "settings": [
    {
      "type": "header",
      "content": "Button content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": "https://",
      "info": "Enter a full HTTPS URL"
    },
    {
      "type": "header",
      "content": "Desktop alignment"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Mobile alignment"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "mobile_full_width",
      "label": "Full width on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "Hover background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#00d9ff"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "Hover text",
      "default": "#00ffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#00d9ff"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow",
      "default": "#00d9ff"
    },
    {
      "type": "range",
      "id": "glow_intensity",
      "label": "Glow intensity",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "hover_glow_intensity",
      "label": "Hover glow intensity",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "inner_glow",
      "label": "Inner glow",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "hover_inner_glow",
      "label": "Hover inner glow",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Button size"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "min_width",
      "label": "Min width (mobile)",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "desktop_min_width",
      "label": "Min width (desktop)",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Min height",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_weight",
      "label": "Font weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "default": 600
    }
  ],
  "presets": [
    {
      "name": "Cyberpunk button"
    }
  ]
}
{% endschema %}
