{% doc %}
  @prompt
    Create a custom button block for a Shopify theme page that includes a built-in horizontal alignment setting (left, center, right) controllable from the Theme Editor. The button should have customizable label text, a link URL, and styling options like button color and text color. Default alignment should be center., the button need to be linked to a https address, This button should have the standard button styling, using the color scheme of the existing website pages.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-button-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-custom-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    {% if block.settings.alignment == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  .ai-custom-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ settings.padding_btn_1 }}px;
    min-width: {{ settings.min_width_btn_1 }}px;
    min-height: {{ settings.min_height_btn_1 }}px;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border: {{ settings.thickness_btn }}px solid rgb(var(--color-button-border));
    border-radius: {{ settings.button_radius }}px;
    font-size: {{ settings.font_size_btn_1 }}px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }

  .ai-custom-button-{{ ai_gen_id }}:hover {
    opacity: 0.85;
  }

  @media screen and (min-width: 750px) {
    .ai-custom-button-{{ ai_gen_id }} {
      min-width: {{ settings.min_width_dt_btn_1 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-custom-button-wrapper-{{ ai_gen_id }} {
      {% if block.settings.mobile_alignment == 'left' %}
        justify-content: flex-start;
      {% elsif block.settings.mobile_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_alignment == 'right' %}
        justify-content: flex-end;
      {% endif %}
    }

    .ai-custom-button-{{ ai_gen_id }} {
      {% if block.settings.mobile_full_width %}
        width: 100%;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-custom-button-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-button-wrapper-{{ ai_gen_id }}">
    <a href="{{ block.settings.button_link }}" class="ai-custom-button-{{ ai_gen_id }}">
      {{ block.settings.button_label }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Custom button",
  "settings": [
    {
      "type": "header",
      "content": "Button content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link (HTTPS URL)",
      "default": "https://",
      "info": "Enter a full HTTPS URL (e.g., https://example.com)"
    },
    {
      "type": "header",
      "content": "Desktop alignment"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Mobile alignment"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "mobile_full_width",
      "label": "Full width on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Custom button"
    }
  ]
}
{% endschema %}
