{% doc %}
  @prompt
    Create an image block for a featured product section that displays a square image (1:1 aspect ratio). The block should allow merchants to upload a custom image, with the image always cropped and displayed as a perfect square. Include settings for image width (small/medium/large/full width), alignment (left/center/right), and top/bottom margin spacing. The image should be responsive and maintain the square ratio on all screen sizes.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-square-image-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.margin_top }}px;
    padding-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-square-image-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  {% if block.settings.alignment == 'left' %}
    .ai-square-image-container-{{ ai_gen_id }} {
      margin-left: 0;
      margin-right: auto;
    }
  {% elsif block.settings.alignment == 'center' %}
    .ai-square-image-container-{{ ai_gen_id }} {
      margin-left: auto;
      margin-right: auto;
    }
  {% elsif block.settings.alignment == 'right' %}
    .ai-square-image-container-{{ ai_gen_id }} {
      margin-left: auto;
      margin-right: 0;
    }
  {% endif %}

  {% if block.settings.image_width == 'small' %}
    @media screen and (min-width: 750px) {
      .ai-square-image-container-{{ ai_gen_id }} {
        max-width: 400px;
      }
    }
  {% elsif block.settings.image_width == 'medium' %}
    @media screen and (min-width: 750px) {
      .ai-square-image-container-{{ ai_gen_id }} {
        max-width: 600px;
      }
    }
  {% elsif block.settings.image_width == 'large' %}
    @media screen and (min-width: 750px) {
      .ai-square-image-container-{{ ai_gen_id }} {
        max-width: 800px;
      }
    }
  {% endif %}

  .ai-square-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-square-image-wrapper-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ai-square-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-square-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-square-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<div class="ai-square-image-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-square-image-container-{{ ai_gen_id }}">
    <div class="ai-square-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="800"
          height="800"
        >
      {% else %}
        <div class="ai-square-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-square-image-empty-state-{{ ai_gen_id }}">
            Add a square image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Square image",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Square image"
    }
  ]
}
{% endschema %}
