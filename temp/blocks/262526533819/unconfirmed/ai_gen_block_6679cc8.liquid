{% doc %}
  @prompt
    Create a new block type specifically designed to be added inside a Featured Product section's product content group block. The block should display a square image (1:1 aspect ratio) that merchants can upload. Include settings for image width (small/medium/large/full width), alignment (left/center/right), and top/bottom margin spacing. The block must be compatible with being nested inside a product content group in a featured product section, and should work on product detail pages. The image should be responsive and maintain the square ratio on all screen sizes.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-square-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-square-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ settings.pr_media_radius }}px;
    {% if block.settings.image_width == 'small' %}
      max-width: 200px;
    {% elsif block.settings.image_width == 'medium' %}
      max-width: 400px;
    {% elsif block.settings.image_width == 'large' %}
      max-width: 600px;
    {% else %}
      max-width: 100%;
    {% endif %}
    {% if block.settings.alignment == 'left' %}
      margin-left: 0;
      margin-right: auto;
    {% elsif block.settings.alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
  }

  .ai-square-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-square-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-square-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-square-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }
{% endstyle %}

<div class="ai-square-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-square-image-container-{{ ai_gen_id }}">
    <div class="ai-square-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="1200"
          height="1200"
        >
      {% else %}
        <div class="ai-square-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Square image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Square image"
    }
  ]
}
{% endschema %}
