{% doc %}
  @prompt
    Create a custom button block for a Shopify theme page that includes a built-in horizontal alignment setting (left, center, right) controllable from the Theme Editor. The button should have customizable label text, a link URL, and styling options like button color and text color. Default alignment should be center.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-button-block-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    padding: 20px 0;
  }

  .ai-button-block-{{ ai_gen_id }}--left {
    justify-content: flex-start;
  }

  .ai-button-block-{{ ai_gen_id }}--center {
    justify-content: center;
  }

  .ai-button-block-{{ ai_gen_id }}--right {
    justify-content: flex-end;
  }

  .ai-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    width: {% if block.settings.full_width_mobile %}100%{% else %}auto{% endif %};
  }

  .ai-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-button-{{ ai_gen_id }} {
      width: auto;
      max-width: {{ block.settings.desktop_width_percent }}%;
    }
  }
{% endstyle %}

<div
  class="ai-button-block-{{ ai_gen_id }} ai-button-block-{{ ai_gen_id }}--{{ block.settings.alignment }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.button_link != blank %}
    <a
      href="{{ block.settings.button_link }}"
      class="ai-button-{{ ai_gen_id }}"
    >
      {{ block.settings.button_text }}
    </a>
  {% else %}
    <span class="ai-button-{{ ai_gen_id }}">
      {{ block.settings.button_text }}
    </span>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom button",
  "settings": [
    {
      "type": "header",
      "content": "Button content"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "full_width_mobile",
      "label": "Full width on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Hover background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Custom button"
    }
  ]
}
{% endschema %}
